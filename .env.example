APP_NAME="SAMA Envios"
APP_ENV=production
APP_KEY=base64:odHTDzo1Si55SQirAoKezkZqKzH0t8vk3w0iZaKjXlw=
APP_DEBUG=true
APP_URL=https://samabranding.duckdns.org
FORCE_HTTPS=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- CONEXÃO COM O BANCO DO LARAVEL ---
# O host deve ser o nome do serviço no docker-compose
DB_CONNECTION=mysql
DB_HOST=157.173.100.233
DB_PORT=3306
DB_DATABASE=whatsapp_sender
DB_USERNAME=marcel
DB_PASSWORD=password_mysql_123

BROADCAST_DRIVER=log
# redis = shared locks/counters between workers and servers (see README, 'Redis')
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# database (default, zero setup) | redis (recommended in production: faster, atomic, delayed jobs)
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=memcached

# --- REDIS (Se for usar, o host é o nome do serviço) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Redis databases: default(0) = locks/counters, cache(1), queue(2)
REDIS_QUEUE_DB=2
REDIS_QUEUE_RETRY_AFTER=300

# --- Pacing of each WhatsApp session (seconds between messages of the same number) ---
WHATSAPP_PACING=true

# --- Alerts when a session goes down / Evolution stops answering / a queue piles up ---
INSTANCE_ALERT_AFTER_MINUTES=3

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contato@amabranding.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# --- CONFIGURAÇÕES DO MINIO (DOCKER) ---
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=sua_senha_forte_123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ads
# Endpoint interno para o Laravel alcançar o Minio na rede do Docker
AWS_ENDPOINT=http://minio:9000
# URL pública para acesso via navegador
AWS_URL=https://samabranding.duckdns.org:9000/ads
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- CONFIGURAÇÕES DA EVOLUTION API ---
WHATSAPP_PROTOCOL=http
WHATSAPP_URL=evolution-api
WHATSAPP_PORT=8081
WHATSAPP_APIKEY=BQYHJGJHJ
WHATSAPP_CONTACT_TEST=5595981110695
WHATSAPP_MESSAGE_UP=21
MIX_WHATSAPP_PUBLIC_URL=samabranding.duckdns.org
MIX_WHATSAPP_PUBLIC_PORT=8080
MIX_WHATSAPP_PUBLIC_PROTOCOL=https

DEBUG_WEBHOOK_STATUS=false

# --- PLANOS E COBRANCA (veja README: Plans & Billing) ---
BILLING_ENABLED=false
BILLING_TRIAL_DAYS=7
BILLING_INVOICE_DAYS_BEFORE=5
BILLING_GRACE_DAYS=3
BILLING_SUSPENSION_DAYS=30

# --- FILA JUSTA DE ENVIO ---
WHATSAPP_BATCH_SIZE=50
WHATSAPP_FAIRNESS=session

# --- AI agents (optional platform keys: users can always bring their own key in the AI section) ---
#GROQ_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#DEEPSEEK_API_KEY=
#MISTRAL_API_KEY=
#OPENROUTER_API_KEY=
# Allow users to point "Ollama / custom" at localhost or private-network hosts (default: only when APP_ENV=local)
#AI_ALLOW_PRIVATE_HOSTS=false
#AI_TIMEOUT=40
# Default working hours for agents that do not set their own
#AI_BUSINESS_TZ=America/Sao_Paulo
#AI_BUSINESS_START=9
#AI_BUSINESS_END=19

# --- Telegram (bots are connected in the app, under "Telegram"; APP_URL must be public https) ---
#TELEGRAM_API_URL=https://api.telegram.org
#TELEGRAM_TIMEOUT=30
#TELEGRAM_MAX_DOWNLOAD_BYTES=20971520

# --- Instagram Direct (accounts are connected in the app, under "Instagram"; APP_URL must be public https) ---
# Meta app dashboard > Instagram > API setup. Callback URL: https://YOUR-DOMAIN/api/webhooks/instagram
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
#INSTAGRAM_API_VERSION=v21.0
#INSTAGRAM_WINDOW_HOURS=24
#INSTAGRAM_TIMEOUT=30
#INSTAGRAM_MAX_DOWNLOAD_BYTES=26214400
#INSTAGRAM_MEDIA_LINK_MINUTES=30

# --- TikTok Business Messaging (accounts are connected in the app under "TikTok" with OAuth; APP_URL must be public https) ---
# Developer portal: Redirect URL https://YOUR-DOMAIN/tiktok/callback · Webhook https://YOUR-DOMAIN/api/webhooks/tiktok
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
#TIKTOK_WINDOW_HOURS=48
#TIKTOK_SIGNATURE_TOLERANCE=300
#TIKTOK_TIMEOUT=30
#TIKTOK_MAX_DOWNLOAD_BYTES=26214400
# Only if the TikTok portal shows different endpoints for your API version:
#TIKTOK_API_URL=https://business-api.tiktok.com/open_api/v1.3
#TIKTOK_AUTH_URL=https://business-api.tiktok.com/portal/auth
#TIKTOK_PATH_SEND=/business/message/send/
