# =============================================================================
# SAMA Envios - environment reference
# Every variable below says WHICH ASPECT of the system it controls.
# Lines starting with "#VAR=" are optional: the value shown is the default.
# Full table with the same information: README.md > "Environment variables".
# =============================================================================
# NO SECRETS IN THIS FILE: copy it to .env and fill the empty ones (DB_PASSWORD, AWS_SECRET_ACCESS_KEY,
# WHATSAPP_APIKEY, APP_KEY). The installers do it for you. Never commit .env.

# --- APPLICATION -------------------------------------------------------------
# Name shown in the UI, e-mails and as the mail "from" name
APP_NAME="SAMA Envios"
# local | production. In "local": pacing/humanize delays are 0 and AI may reach private hosts
APP_ENV=production
# Encryption key (sessions, encrypted API keys). Left empty on purpose: install.sh / start-local.sh generate one, or run: php artisan key:generate
APP_KEY=
# true shows stack traces to visitors. MUST be false in production
APP_DEBUG=false
# PUBLIC https address. Used to build webhook/OAuth callback URLs (Telegram, Instagram, Facebook, TikTok, payment gateways)
APP_URL=http://localhost
# Force https links/assets (needed behind a reverse proxy that terminates TLS)
FORCE_HTTPS=false
# Default UI language when the user has not chosen one: en | pt_BR | es
#APP_LOCALE=en

# Where application logs go (stack | single | daily | stderr ...) and the minimum level recorded
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- DATABASE (MySQL) --------------------------------------------------------
# With Docker the host is the compose service name
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsapp_sender
DB_USERNAME=sama
# Choose a strong password (install.sh / start-local.sh generate one when this is empty)
DB_PASSWORD=

# --- BROADCAST / CACHE / QUEUE / SESSION --------------------------------------
# Real-time broadcasting driver (log = disabled)
BROADCAST_DRIVER=log
# redis = locks/counters shared between workers and servers (see README, 'Redis')
CACHE_DRIVER=file
# Where uploaded files go: local | s3 (s3 = MinIO/AWS block below)
FILESYSTEM_DISK=local
# database (default, zero setup) | redis (recommended in production: faster, atomic, delayed jobs)
QUEUE_CONNECTION=database
# Where login sessions are kept and for how long (minutes)
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=memcached

# --- REDIS (only if used; with Docker the host is the service name) ---------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Redis databases: default(0) = locks/counters, cache(1), queue(2)
REDIS_QUEUE_DB=2
# Seconds before a running job is considered lost and retried (must exceed the longest job)
REDIS_QUEUE_RETRY_AFTER=300
# Name of the default Redis queue
#REDIS_QUEUE=default

# --- WHATSAPP SEND PACING (anti-ban) ------------------------------------------
# true = enforce a pause between two messages of the same number (session)
WHATSAPP_PACING=true
# Random cooldown (seconds) between messages of the same number. 0 in APP_ENV=local
#WHATSAPP_COOLDOWN_MIN=25
#WHATSAPP_COOLDOWN_MAX=50
# Random "typing" delay (seconds) before each send, to look human. 0 in APP_ENV=local
#WHATSAPP_HUMANIZE_MIN=4
#WHATSAPP_HUMANIZE_MAX=9
# Hours a message stays "in flight" (queued to Evolution, no result yet) before being counted again
#WHATSAPP_INFLIGHT_WINDOW_HOURS=24
# Schedule the automatic queue run (whatsapp:queue). Without it, run the command by hand / via cron
#WHATSAPP_AUTOSEND=true
# Cron expression of that run
#WHATSAPP_QUEUE_CRON="0 * * * *"

# --- SESSION / QUEUE ALERTS (e-mail to the owner) ---------------------------------
# Minutes a session may stay down before the owner is alerted
INSTANCE_ALERT_AFTER_MINUTES=3
# Consecutive Evolution failures that count as "Evolution is down"
#INSTANCE_FAILURE_THRESHOLD=3
# Cron of the health check (instances:health)
#INSTANCE_HEALTH_CRON="*/5 * * * *"
# Repeat the alert if the problem persists after N hours
#INSTANCE_REALERT_AFTER_HOURS=12
# A session is only monitored if it sent something in the last N hours
#INSTANCE_RECENT_SEND_HOURS=24
# Alert when a queue has more than N pending jobs (queue:monitor, Redis only)
#QUEUE_BACKLOG_MAX=500

# --- E-MAIL (alerts, invoices, password reset) ----------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- FILE STORAGE (MinIO / S3): campaign images, chat media ---------------------------
AWS_ACCESS_KEY_ID=sama
# Choose a strong password (this is also the MinIO admin password in the Docker stacks)
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ads
# Internal endpoint so Laravel reaches MinIO inside the Docker network
AWS_ENDPOINT=http://minio:9000
# Public URL the browser uses to display the files
AWS_URL=http://localhost:9000/ads
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- EVOLUTION API (WhatsApp gateway) -------------------------------------------------
WHATSAPP_PROTOCOL=http
WHATSAPP_URL=evolution-api
WHATSAPP_PORT=8081
# Global key of Evolution (AUTHENTICATION_API_KEY on the Evolution side)
# Choose a long random value; the Evolution API container receives the same one (AUTHENTICATION_API_KEY)
WHATSAPP_APIKEY=
# Your own number (with country code) that receives the "test connection" message
WHATSAPP_CONTACT_TEST=
# Fallback only: the signup welcome message is chosen in Admin > Signup welcome
WHATSAPP_MESSAGE_UP=21
# Public address of Evolution as the BROWSER sees it (QR code / pairing screen)
MIX_WHATSAPP_PUBLIC_URL=localhost
MIX_WHATSAPP_PUBLIC_PORT=8080
MIX_WHATSAPP_PUBLIC_PROTOCOL=http

# --- DEBUG FLAGS (leave false in production: they write a lot to the log) ----------------
DEBUG_WEBHOOK_STATUS=false
#AI_DEBUG_FLOW=false
#AI_DEBUG_WEBHOOK=false
#DEBUG_WHATSAPP_QR=false

# --- PLANS AND BILLING (see README: Plans & Billing) ----------------------------------------
# false = everything free/unlimited; true = plans, limits and blocking apply
BILLING_ENABLED=false
#BILLING_CURRENCY=BRL
# Other currencies customers can choose (units per 1 BRL; Stripe / PayPal only, no Pix)
#BILLING_RATE_USD=0.18
#BILLING_RATE_EUR=0.16
# Free trial length of paid plans (days)
BILLING_TRIAL_DAYS=7
# Days before the due date that the invoice is generated
BILLING_INVOICE_DAYS_BEFORE=5
# Days after the due date the account still works (grace) before going read-only
BILLING_GRACE_DAYS=3
# Days read-only before the subscription is suspended
BILLING_SUSPENSION_DAYS=30
# A paid plan without trial must be paid within N days or the request expires
#BILLING_PENDING_DAYS=3

# --- FAIR SEND QUEUE ------------------------------------------------------------------
# Messages per batch (each batch is balanced between users/sessions)
WHATSAPP_BATCH_SIZE=50
# How a batch is divided: session | user | fifo (no balancing)
WHATSAPP_FAIRNESS=session
# Plan priority in the shared queue: weighted (proportional share, nobody starves) | strict (higher plans first)
#WHATSAPP_PRIORITY=true
#WHATSAPP_PRIORITY_MODE=weighted
# Seconds between campaign messages sent through Telegram / Instagram / Facebook / TikTok
#CAMPAIGN_CHANNEL_DELAY=3

# --- CHAT (omnichannel inbox) -----------------------------------------------------------
# How often (ms) the browser refreshes the chat list and the open conversation
#CHAT_POLL_CHATS_MS=6000
#CHAT_POLL_MESSAGES_MS=2500
# Largest file (KB) an attendant can upload in the chat (default 16 MB)
#CHAT_MAX_UPLOAD_KB=16384
# true = AI stops answering a chat as soon as a human replies in it
#CHAT_PAUSE_AI_ON_REPLY=false
# Mark the customer's messages as read when the attendant sends a reply
#CHAT_SEND_READ_RECEIPTS=true
# Text appended to messages typed in the CRM chat
#CHAT_SIGNATURE_SUFFIX="(CRM)"
# History import: how many chats and how many messages per chat
#CHAT_HISTORY_MAX_CHATS=200
#CHAT_HISTORY_PER_CHAT=200

# --- AI AGENTS (optional platform keys: users can always bring their own key in the AI section) ---
#GROQ_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#DEEPSEEK_API_KEY=
#MISTRAL_API_KEY=
#OPENROUTER_API_KEY=
# Allow users to point "Ollama / custom" at localhost or private-network hosts (default: only when APP_ENV=local)
#AI_ALLOW_PRIVATE_HOSTS=false
# Provider timeout in seconds
#AI_TIMEOUT=40
# Default working hours for agents that do not set their own (AI is silent outside them)
#AI_BUSINESS_TZ=America/Sao_Paulo
#AI_BUSINESS_START=9
#AI_BUSINESS_END=19

# --- TELEGRAM (bots are connected in the app, under "Telegram"; APP_URL must be public https) ---
# Bot API address (change only for a self-hosted Bot API server)
#TELEGRAM_API_URL=https://api.telegram.org
#TELEGRAM_TIMEOUT=30
# Largest file downloaded from Telegram (bytes, 20 MB)
#TELEGRAM_MAX_DOWNLOAD_BYTES=20971520

# --- INSTAGRAM DIRECT (accounts are connected in the app, under "Instagram"; APP_URL must be public https) ---
# Meta app dashboard > Instagram > API setup. Callback URL: https://YOUR-DOMAIN/api/webhooks/instagram
# App secret: validates the signature of every incoming webhook
INSTAGRAM_APP_SECRET=
# Token you type in the Meta dashboard to verify the webhook
INSTAGRAM_VERIFY_TOKEN=
#INSTAGRAM_API_VERSION=v21.0
# Graph API base URL (change only if Meta moves it)
#INSTAGRAM_GRAPH_URL=
# Hours after the customer's last message during which we may reply
#INSTAGRAM_WINDOW_HOURS=24
#INSTAGRAM_TIMEOUT=30
#INSTAGRAM_MAX_DOWNLOAD_BYTES=26214400
# Minutes a public link to a media file stays valid (Instagram downloads it from us)
#INSTAGRAM_MEDIA_LINK_MINUTES=30

# --- FACEBOOK MESSENGER (Pages). The secrets default to the Instagram ones: one Meta app can serve both ---
#FACEBOOK_APP_SECRET=
#FACEBOOK_VERIFY_TOKEN=
#FACEBOOK_API_VERSION=v21.0
#FACEBOOK_GRAPH_URL=
#FACEBOOK_WINDOW_HOURS=24
#FACEBOOK_TIMEOUT=30
#FACEBOOK_MAX_DOWNLOAD_BYTES=26214400

# --- TIKTOK BUSINESS MESSAGING (accounts are connected in the app under "TikTok" with OAuth; APP_URL must be public https) ---
# Developer portal: Redirect URL https://YOUR-DOMAIN/tiktok/callback · Webhook https://YOUR-DOMAIN/api/webhooks/tiktok
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Hours after the customer's last message during which we may reply
#TIKTOK_WINDOW_HOURS=48
# Seconds of clock difference accepted when validating the webhook signature
#TIKTOK_SIGNATURE_TOLERANCE=300
#TIKTOK_TIMEOUT=30
#TIKTOK_MAX_DOWNLOAD_BYTES=26214400
# Only if the TikTok portal shows different endpoints for your API version:
#TIKTOK_API_URL=https://business-api.tiktok.com/open_api/v1.3
#TIKTOK_AUTH_URL=https://business-api.tiktok.com/portal/auth
#TIKTOK_PATH_SEND=/business/message/send/
# Other endpoint paths that can be overridden the same way:
#TIKTOK_PATH_TOKEN=
#TIKTOK_PATH_REFRESH=
#TIKTOK_PATH_MESSAGES=
#TIKTOK_PATH_UPLOAD=
#TIKTOK_PATH_DOWNLOAD=
#TIKTOK_PATH_WEBHOOK=

# --- E-MAIL CHANNEL (mailboxes are connected in the app under "Email"; credentials are stored encrypted, not here) ---
# How often the mailboxes (IMAP) are checked for new mail (cron expression)
#EMAIL_FETCH_CRON="* * * * *"
# Most new messages imported from one mailbox per check
#EMAIL_MAX_PER_POLL=20
# Bigger attachments are not kept in the chat (bytes, 10 MB)
#EMAIL_MAX_ATTACHMENT_BYTES=10485760
# Seconds to wait for an SMTP / IMAP server
#EMAIL_TIMEOUT=20
# Allow servers on localhost / private networks (default: only APP_ENV=local). Keep false on a shared host (SSRF protection)
#EMAIL_ALLOW_PRIVATE_HOSTS=false
# Ports users may use (empty = any)
#EMAIL_SMTP_PORTS=25,465,587,2525
#EMAIL_IMAP_PORTS=143,993
# Loop protection: the AI answers one sender at most this many times per day
#EMAIL_AI_MAX_REPLIES_PER_DAY=5

# --- CONTACT FORMS (embeddable <script>; see README: Contact forms) ---
# Prefix added to phone numbers typed without a country code (empty = leave as typed)
#FORMS_DEFAULT_COUNTRY_CODE=55
# Submissions accepted per minute from one IP address (spam protection of the public endpoint)
#FORMS_THROTTLE_PER_MINUTE=10

# Deals: a customer back after this many days without writing is a new lead (with "open a deal automatically" on)
#DEAL_NEW_AFTER_DAYS=30

# Symbol shown before the totals of proposals (quotes)
#CRM_CURRENCY=R$

# --- CONSENT: words (whole message, any case, comma separated) that opt a customer out / in on every channel ---
#CONSENT_OPTOUT_KEYWORDS=#sair,/stop,#parar,#stop,parar,stop
#CONSENT_OPTIN_KEYWORDS=#entrar,#aceito,/start

# --- UNRESPONSIVE CONTACTS: deactivate WhatsApp contacts whose messages never get delivered ---
#CONTACT_UNDELIVERED_ENABLED=true
# Hours a message may stay "sent" without a delivery receipt before it counts as undelivered
#CONTACT_UNDELIVERED_AFTER_HOURS=72
# How many undelivered messages (and no sign of life) deactivate the contact
#CONTACT_UNDELIVERED_MIN_MESSAGES=1
#CONTACT_UNDELIVERED_LOOKBACK_DAYS=30
#CONTACT_UNDELIVERED_EVIDENCE_DAYS=30
# Reactivate automatically when the contact writes or a delivery receipt finally arrives
#CONTACT_UNDELIVERED_REACTIVATE=true

# --- CONTACT SCORE (0-100) AND RANKING (used by the campaign audience filter) ---
#CONTACT_SCORE_ENABLED=true
# Recent activity window and how often (hours) a contact's score is recalculated
#CONTACT_SCORE_WINDOW_DAYS=90
#CONTACT_SCORE_REFRESH_HOURS=24
# Tier thresholds: hot >= 70, warm >= 40, cold >= 15, below that frozen
#CONTACT_SCORE_HOT=70
#CONTACT_SCORE_WARM=40
#CONTACT_SCORE_COLD=15

# --- Typebot (self-hosted flow builder; see README "Typebot flows") ---------------------------
# Production (.docker/docker-compose.yml): required. Local (docker-compose.local.yml --profile typebot) has defaults.
TYPEBOT_DB_PASSWORD=
TYPEBOT_ENCRYPTION_SECRET=
TYPEBOT_BUILDER_URL=https://your-domain:8443
TYPEBOT_VIEWER_URL=https://your-domain:8444
TYPEBOT_ADMIN_EMAIL=
TYPEBOT_DISABLE_SIGNUP=false

# AI business knowledge: where the vectors are kept. "database" (default) or "qdrant" (docker compose --profile qdrant up -d)
RAG_VECTOR_STORE=database
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
